# Строка подключения к PostgreSQL базе данных
# Для локальной разработки: postgresql://postgres:YOUR_PASSWORD@localhost:5432/keytracker
# Для Railway: автоматически предоставляется
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/keytracker

# Секретный ключ для JWT токенов (обязательно измените!)
JWT_SECRET=your-secret-key-here-change-this

# Пароль для администратора по умолчанию
ADMIN_PASSWORD=admin123

# Пароль для обычного пользователя по умолчанию
USER_PASSWORD=user123

# Порт сервера
# Для Railway оставьте пустым, Railway установит автоматически
PORT=3000

# Режим разработки (опционально)
# NODE_ENV=development